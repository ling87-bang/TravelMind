# Copy to .env and fill your primary model key. Never commit .env.
DASHSCOPE_API_KEY=
QWEN_MODEL_NAME=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15433
POSTGRES_DB=travel_planner_db
POSTGRES_USER=knowgo
POSTGRES_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
JWT_SECRET_KEY=
LANGSMITH_TRACING=false
DEEPEVAL_TELEMETRY_OPT_OUT=YES
# Optional: blank uses the primary model for itinerary extraction and summaries.
DEEP_SEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional real-time data providers. Public 12306 is enabled without a key.
AMAP_API_KEY=
TAVILY_API_KEY=
VARIFLIGHT_API_KEY=
AIGOHOTEL_MCP_API=
QQ_MAP_KEY=
# Comma-separated override, e.g. 12306-mcp,bailian-websearch; none disables MCP.
MCP_ENABLED_SERVERS=
MCP_CONNECT_TIMEOUT=25
MCP_TOOL_TIMEOUT=45
